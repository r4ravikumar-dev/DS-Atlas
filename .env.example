# Frontend (Next.js). Server-only: the backend base URL used by the same-origin /api/v1 proxy.
BACKEND_URL=https://api.example.com

# Absolute site URL for canonical links, Open Graph and the sitemap (defaults to the Vercel production URL).
NEXT_PUBLIC_SITE_URL=https://directory.example.com

# Shared with the backend's RENDER_API_KEY: server-side rendering is exempt from the anonymous API rate limit.
RENDER_API_KEY=

# Shared with the backend's REVALIDATE_SECRET: lets a content-changing build refresh just the affected pages via POST /revalidate.
REVALIDATE_SECRET=

# Backend configuration (including DATABASE_URL, SECRET_KEY, and optional GITHUB_TOKEN)
# is configured in backend/.env (see backend/.env.example and docs/github-integration-guide.md).
# GITHUB_TOKEN raises the GitHub API quota from 60 to 5,000 req/h for repository inspection.

