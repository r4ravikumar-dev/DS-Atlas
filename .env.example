# Frontend (Next.js). Server-only: the backend base URL used by the same-origin /api/v1 proxy.
BACKEND_URL=https://api.example.com

# Backend configuration (including DATABASE_URL, SECRET_KEY, and optional GITHUB_TOKEN)
# is configured in backend/.env (see backend/.env.example and docs/github-integration-guide.md).
# GITHUB_TOKEN raises the GitHub API quota from 60 to 5,000 req/h for repository inspection.

