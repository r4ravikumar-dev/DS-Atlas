# Copy to .env and fill in. Never commit real secrets.
ENVIRONMENT=development                 # development | test | production
DATABASE_URL=postgresql+psycopg://dsrp:CHANGE_ME@localhost:5432/dsrp
# Supabase (production): API + worker use the transaction pooler (port 6543, auto-detected); migrations use the session pooler (5432).
#   DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#   MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_POOL_MODE=auto                       # auto | direct | transaction
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-48
COOKIE_SECURE=true                      # true behind HTTPS
COOKIE_DOMAIN=
CORS_ORIGINS=[]                         # only needed if the frontend is NOT served through the same-origin proxy
STORAGE_DIR=                            # defaults to backend/storage (raw documents, exports, engine cache); /tmp/dsrp-storage on Vercel
STORAGE_BACKEND=local                   # local | supabase  (Vercel: supabase, so the API and the worker share files)
SUPABASE_URL=                           # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=              # server-side secret: never NEXT_PUBLIC_*, never in the browser, never committed
SUPABASE_STORAGE_BUCKET=dsrp-private    # private bucket; create with `manage.py setup-storage`
WORKER_CONCURRENCY=4
EXPORT_TTL_HOURS=24
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Optional. Read-only token for public GitHub metadata (raises the REST limit from 60 to 5,000 req/h).
# Fine-grained PAT with "Public repositories (read-only)" and no other permissions, or a GitHub App token.
# Supply via the environment / deployment secret store or the git-ignored .env — never commit it, never paste it in chat.
GITHUB_TOKEN=

# Daily synchronization (the worker's scheduler loop is the primary trigger; Vercel Cron calls /api/v1/internal/cron/sync as a backup)
SCHEDULER_TICK_SECONDS=30               # how often each worker checks whether the daily run is due (claiming is atomic in the DB)
CRON_SECRET=                            # Vercel sends "Authorization: Bearer $CRON_SECRET"; leave empty to disable the cron endpoint
PUBLIC_RATE_LIMIT_PER_MINUTE=240        # anonymous API requests per client IP per minute (per instance)
