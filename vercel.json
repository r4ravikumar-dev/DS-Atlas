{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "daemons": {
    "worker": {
      "root": "backend/",
      "entrypoint": "Dockerfile.worker",
      "instances": {
        "iad1": 1
      },
      "terminationGracePeriodSeconds": 300
    }
  }
}
